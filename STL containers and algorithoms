3) Hash: convert a key (string, integer, object) in hash code 
then store data in bucket with that hash code. search/insert/delete average 1 time need
#include <bits/stdc++.h>
    string key = "Rahim";
    hash<string> h;
    size_t hashValue = h(key);
    cout << "Hash of " << key << " = " << hashValue ;  //Hash of Rahim = 1234567890 
      
    int bucketIndex = hashValue % 10;
    cout << "Bucket index = " << bucketIndex << endl; //Bucket index = 0             

    unordered_map<string,int> marks;
    marks["Rahim"] = 95;
    marks["Karim"] = 88;
    cout << "Rahim -> " << marks["Rahim"] << endl;     //Rahim -> 95
    for(auto &p : marks){
        cout << p.first << " stored in bucket " << marks.bucket(p.first) << endl;
    }   //Rahim stored in bucket 3 , Karim stored in bucket 7
